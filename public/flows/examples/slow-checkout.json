          "pool_active": 3,
          "pool_size": 12
        }
      },
      "footer": [
        {
          "text": "**10 ms** \u2014 pool was 3 of 12 busy, so no queueing at the LB",
          "style": "success"
        }
      ],
      "waterfall": {
        "start": 60,
        "weight": 10,
        "label": "10 ms \u00b7 upstream pick",
        "color": "#22c55e"
      }
    },
    {
      "id": 4,
