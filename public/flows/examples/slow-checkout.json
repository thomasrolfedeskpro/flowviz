  "steps": [
    {
      "id": 0,
      "name": "Overview",
      "title": "One checkout, 3,520 ms",
      "description": "A shopper clicked Pay and waited three and a half seconds. Every hop below is a span from that single trace. Open the waterfall to see the shape of it before we walk through.",
      "highlight": [],
      "active_connections": [],
      "camera": {
        "fit": true
      }
    },
    {
      "id": 1,
      "name": "Pay clicked",
      "title": "Shopper clicks Pay",
      "description": "The button handler serialises the cart id and posts it. Client-side work is 15 ms, so nothing here explains the wait.",
      "highlight": [
        "browser"
      ],
      "active_connections": [],
      "camera": {
        "focus": "browser",
        "zoom": 1.5
      },
      "annotations": [
        {
          "type": "callout",
          "target": "browser",
          "text": "fetch('/checkout', { method: 'POST', body: cartId })",
          "style": "info"
        }
      ],
      "packet": null,
      "footer": [
        {
          "text": "**15 ms** of client work \u2014 the browser is not the problem",
          "style": "success"
        }
      ],
      "waterfall": {
        "start": 0,
        "weight": 15,
        "label": "15 ms \u00b7 client",
        "color": "#22c55e"
      }
    },
    {
      "id": 2,
      "name": "Edge miss",
      "title": "Request reaches the CDN and misses",
      "description": "Checkout routes carry `no-store`, so the edge never has a cached answer. The 45 ms is TLS plus the hop to origin, which is exactly what we would expect.",
      "highlight": [
        "browser",
        "cdn"
      ],
      "active_connections": [
        "c_browser_cdn"
      ],
      "packet": {
        "connection": "c_browser_cdn",
        "shape": "document",
        "arrivalStyle": "success",
        "data": {
          "method": "POST",
          "path": "/checkout",
          "cart_id": "cart_7f3ac9",
          "cf_cache_status": "BYPASS"
        }
      },
      "footer": [
        {
          "text": "**45 ms** \u2014 normal for a cold POST from this region",
          "style": "success"
        }
      ],
      "waterfall": {
        "start": 15,
        "weight": 45,
        "label": "45 ms \u00b7 edge + TLS",
        "color": "#22c55e"
      }
    },
    {
      "id": 3,
      "name": "Origin routing",
      "title": "Load balancer picks a pod",
