    {
      "id": 9,
      "name": "N+1 storm",
      "title": "Pricing runs one query per line",
      "description": "`priceLines()` loops the 25 cart lines and calls `$productRepo->find()` inside the loop, so the same product lookup is issued 25 times, serially. Each query is only ~127 ms including round trip and connection checkout, but 25 of them back to back is 3,180 ms.",
      "highlight": [
        "cart_service",
        "orders_db"
      ],
      "active_connections": [
        "c_cart_db"
      ],
      "camera": {
        "focus": "orders_db",
        "zoom": 1.8
      },
      "annotations": [
        {
          "type": "transform",
          "target": "cart_service",
          "text": "foreach ($lines as $l) { $productRepo->find($l->productId); }",
          "style": "error"
        },
        {
          "type": "callout",
          "target": "orders_db",
          "text": "25 \u00d7 SELECT * FROM products WHERE id = $1",
          "style": "warning"
        }
      ],
      "packet": {
        "connection": "c_cart_db",
        "shape": "token",
        "count": 25,
        "arrivalStyle": "error",
        "data": {
          "query": "SELECT * FROM products WHERE id = $1",
          "executions": 25,
          "total_ms": 3180,
          "median_ms": 124,
          "max_ms": 191,
          "distinct_products": 19
        }
      },
      "footer": [
        {
          "text": "**Slow step \u2014 3,180 ms** across 25 identical queries",
          "style": "error"
        },
        {
          "text": "Nothing is waiting on the database engine: it answers each one in ~2 ms. The cost is 25 serial round trips.",
          "style": "warning"
        }
      ],
      "waterfall": {
        "start": 152,
        "weight": 3180,
        "label": "3,180 ms \u00b7 \u00d725 queries",
        "color": "#ef4444"
      }
    },
    {
