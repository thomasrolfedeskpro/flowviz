    {
      "id": 8,
      "name": "Cart rows read",
      "title": "One query fetches 25 cart lines",
      "description": "The cart itself loads in a single indexed query returning 25 rows in 22 ms. This is what a healthy database call looks like \u2014 remember it for the next step.",
