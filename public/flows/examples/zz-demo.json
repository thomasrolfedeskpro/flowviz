{
  "meta": {
    "title": "ZZ Demo \u2014 repeats, waterfall, footer",
    "description": "Scratch flow exercising packet count, the waterfall tab and step footers."
  },
  "layout": {
    "grid": {
      "cols": 14,
      "rows": 8
    }
  },
  "zones": [
    {
      "id": "z_app",
      "label": "App",
      "color": "#3b82f6",
      "bounds": {
        "col": 0,
        "row": 2,
        "width": 8,
        "height": 4
      }
    }
  ],
  "components": [
    {
      "id": "web",
      "label": "Web",
      "type": "client",
      "position": {
        "col": 1,
        "row": 3
      }
    },
    {
      "id": "api",
      "label": "API",
      "type": "service",
      "position": {
        "col": 5,
        "row": 3
      }
    },
    {
      "id": "db",
      "label": "MySQL",
      "type": "database",
      "shape": "cylinder",
      "position": {
        "col": 10,
        "row": 3
      }
    }
  ],
  "connections": [
    {
      "id": "c_web_api",
      "from": "web",
      "to": "api",
      "label": "POST /tickets",
      "route": "auto"
    },
    {
      "id": "c_api_db",
      "from": "api",
      "to": "db",
      "label": "SELECT channel",
      "route": "auto"
    }
  ],
  "steps": [
    {
      "id": 0,
      "title": "Overview",
      "name": "Overview",
      "highlight": [],
      "active_connections": [],
      "description": "A request that fans into a pile of repeated queries.",
      "waterfall": {
        "weight": 4570,
        "label": "4,570 ms total",
        "color": "#64748b",
        "start": 0
      }
    },
    {
      "id": 1,
      "title": "Request arrives",
      "name": "Request arrives",
      "description": "The browser posts the form.",
      "highlight": [
        "web",
        "api"
      ],
      "active_connections": [
        "c_web_api"
      ],
      "packet": {
        "connection": "c_web_api",
        "shape": "document"
      },
      "footer": [
        {
          "text": "Handled in **32 ms** \u2014 nothing to see here",
          "style": "success"
        }
      ],
      "waterfall": {
        "weight": 32,
        "label": "32 ms",
        "color": "#22c55e",
        "start": 0
      }
    },
    {
      "id": 2,
      "title": "N+1 query storm",
      "name": "N+1 query storm",
      "description": "The serializer loads each channel separately.",
      "highlight": [
        "api",
        "db"
      ],
      "active_connections": [
        "c_api_db"
      ],
      "packet": {
        "connection": "c_api_db",
        "shape": "token",
        "count": 25
      },
      "footer": [
        {
          "text": "**Slow step \u2014 3,180 ms** across 25 identical queries",
          "style": "error"
        },
        {
          "text": "Collapse with an `IN (...)` batch to save ~3 s",
          "style": "warning"
        }
      ],
      "waterfall": {
        "weight": 3180,
        "label": "3,180 ms \u00b7 \u00d725",
        "color": "#ef4444",
        "start": 240
      }
    },
    {
      "id": 3,
      "title": "Response",
      "name": "Response",
      "description": "JSON goes back to the browser.",
      "highlight": [
        "api",
        "web"
      ],
      "active_connections": [
        "c_web_api"
      ],
      "packet": {
        "connection": "c_web_api",
        "shape": "envelope",
        "direction": "reverse"
      },
      "footer": [
        {
          "text": "Serialised *18 channels*",
          "style": "info"
        }
      ],
      "waterfall": {
        "weight": 141,
        "label": "141 ms",
        "color": "#3b82f6",
        "start": 4180
      }
    }
  ]
}
