{
  "meta": {
    "title": "Airport Departure \u2014 kerb to wheels-up",
    "description": "One passenger and one suitcase leave the kerb together, split at bag drop, and meet again on the aircraft. The baggage hall and the security checkpoint each open up into a scene of their own.",
    "waterfallLabel": "Elapsed time"
  },
  "layout": {
    "grid": {
      "cols": 26,
      "rows": 12
    }
  },
  "zones": [
    {
      "id": "z_landside",
      "label": "Landside",
      "color": "#4a9edd",
      "bounds": {
        "col": 0,
        "row": 0,
        "width": 9,
        "height": 12
      },
      "meta": {
        "description": "Everything before the security search \u2014 anyone can walk in here, ticket or not.",
        "notes": "Kerb, check-in hall and bag drop share the same public floor."
      }
    },
    {
      "id": "z_airside",
      "label": "Airside",
      "color": "#2d9f6a",
      "bounds": {
        "col": 10,
        "row": 0,
        "width": 10,
        "height": 12
      },
      "meta": {
        "description": "Sterile area. Only screened passengers, screened bags and cleared staff get past this line.",
        "notes": "The baggage hall is airside too, even though no passenger ever sees it."
      }
    },
    {
      "id": "z_apron",
      "label": "Apron",
      "color": "#e8a838",
      "outline": "dashed",
      "bounds": {
        "col": 21,
        "row": 0,
        "width": 5,
        "height": 12
      },
      "meta": {
        "description": "The aircraft stand and its service roads \u2014 a movement area, not a building, so the boundary is a painted line rather than a wall.",
        "notes": "Drawn dashed because it is a procedural boundary, not a physical one."
      }
    }
  ],
  "components": [
    {
      "id": "kerbside",
      "label": "Kerbside",
      "type": "client",
      "icon": "carSide",
      "position": {
        "col": 1,
        "row": 5
      },
      "size": {
        "w": 2,
        "h": 2
      },
      "meta": {
        "description": "Set-down at departures. The passenger and the suitcase arrive as one unit and are about to stop being one.",
        "notes": "Most airports cap the free set-down at 10 minutes."
      }
    },
    {
      "id": "checkin_desk",
      "label": "Check-in Desk",
      "type": "service",
      "icon": "userCheck",
      "position": {
        "col": 5,
        "row": 1
      },
      "size": {
        "w": 2,
        "h": 1
      },
      "meta": {
        "description": "Confirms the booking, checks travel documents, weighs the hold bag and prints the bag tag and boarding pass.",
        "notes": "The bag tag's licence-plate number is what every downstream system actually tracks."
      }
    },
    {
      "id": "bag_drop",
      "label": "Bag Drop",
      "type": "service",
      "icon": "suitcaseRolling",
      "position": {
        "col": 5,
        "row": 4
      },
      "size": {
        "w": 2,
        "h": 1
      },
      "meta": {
        "description": "Where the passenger lets go of the suitcase. The belt takes the bag; the passenger keeps walking.",
        "notes": "This is the divergence point for the two journeys."
      }
    },
    {
      "id": "security",
      "label": "Security Checkpoint",
      "type": "service",
      "icon": "shieldHalved",
      "position": {
        "col": 11,
        "row": 1
      },
      "size": {
        "w": 2,
        "h": 2
      },
      "meta": {
        "description": "Passenger screening: cabin bags through the X-ray, people through the body scanner, anything ambiguous to a hand search.",
        "notes": "Open the checkpoint to see the lane in detail."
      },
      "detail": {
        "grid": {
          "cols": 20,
          "rows": 10
        },
        "zones": [
          {
            "id": "z_sec_lane",
            "label": "Screening Lane",
            "color": "#7c5cc4",
            "bounds": {
              "col": 0,
              "row": 0,
              "width": 19,
              "height": 10
            },
            "meta": {
              "description": "One lane of a bank of identical lanes. Throughput is set by the slowest stage, which is almost always divest."
            }
          }
        ],
        "components": [
          {
            "id": "sec_tray",
            "label": "Divest Bench",
            "type": "queue",
            "icon": "boxOpen",
            "position": {
              "col": 1,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 2
            },
            "meta": {
              "description": "Trays are loaded here: cabin bag, coat, laptop, liquids. The queue backs up at this bench, not at the scanner."
            }
          },
          {
            "id": "sec_scanner",
            "label": "Cabin Bag X-ray",
            "type": "service",
            "icon": "magnifyingGlass",
            "position": {
              "col": 6,
              "row": 1
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Dual-view or CT X-ray. Newer CT machines are why some airports no longer make you take the laptop out."
            }
          },
          {
            "id": "sec_body",
            "label": "Body Scanner",
            "type": "service",
            "icon": "personWalking",
            "position": {
              "col": 6,
              "row": 6
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Millimetre-wave scanner. It flags a region of the body outline rather than producing an image of the person."
            }
          },
          {
            "id": "sec_search",
            "label": "Search Bench",
            "type": "function",
            "icon": "magnifyingGlassPlus",
            "position": {
              "col": 12,
              "row": 8
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Secondary search. The bag is opened in front of its owner and the suspect item swabbed for explosive trace."
            }
          },
          {
            "id": "sec_repack",
            "label": "Repack Bench",
            "type": "service",
            "icon": "suitcase",
            "position": {
              "col": 16,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 2
            },
            "meta": {
              "description": "Reclaim, belt back on, laptop away. Cleared passengers and cleared bags reunite here."
            }
          }
        ],
        "connections": [
          {
            "id": "c_sec_tray_scan",
            "from": "sec_tray",
            "to": "sec_scanner",
            "label": "tray on belt",
            "route": "auto"
          },
          {
            "id": "c_sec_tray_body",
            "from": "sec_tray",
            "to": "sec_body",
            "label": "walk through",
            "route": "auto"
          },
          {
            "id": "c_sec_scan_repack",
            "from": "sec_scanner",
            "to": "sec_repack",
            "label": "cleared",
            "route": "auto"
          },
          {
            "id": "c_sec_scan_search",
            "from": "sec_scanner",
            "to": "sec_search",
            "label": "flagged",
            "route": "auto"
          },
          {
            "id": "c_sec_body_repack",
            "from": "sec_body",
            "to": "sec_repack",
            "label": "no alarm",
            "route": "auto"
          },
          {
            "id": "c_sec_search_repack",
            "from": "sec_search",
            "to": "sec_repack",
            "label": "released",
            "route": "auto"
          }
        ]
      }
    },
    {
      "id": "concourse",
      "label": "Airside Concourse",
      "type": "service",
      "icon": "shop",
      "position": {
        "col": 15,
        "row": 1
      },
      "size": {
        "w": 2,
        "h": 1
      },
      "meta": {
        "description": "Shops, food and the departures board. Airports make more money per passenger here than they do from the airline.",
        "notes": "Gate numbers are usually withheld until roughly 45 minutes before departure to keep people in this space."
      }
    },
    {
      "id": "gate",
      "label": "Gate 27",
      "type": "service",
      "icon": "doorOpen",
      "position": {
        "col": 15,
        "row": 4
      },
      "size": {
        "w": 2,
        "h": 1
      },
      "meta": {
        "description": "Boarding pass scanned against the departure control system, then down the jet bridge.",
        "notes": "The scan is the last chance to catch a passenger who checked a bag but never boarded."
      }
    },
    {
      "id": "baggage_hall",
      "label": "Baggage Hall",
      "type": "queue",
      "icon": "boxesStacked",
      "position": {
        "col": 11,
        "row": 8
      },
      "size": {
        "w": 3,
        "h": 2
      },
      "meta": {
        "description": "Kilometres of belt under the terminal, screening and sorting every hold bag by flight.",
        "notes": "Open the hall to follow the suitcase through it."
      },
      "detail": {
        "grid": {
          "cols": 26,
          "rows": 8
        },
        "zones": [
          {
            "id": "z_bh_screen",
            "label": "Screening",
            "color": "#c4643c",
            "bounds": {
              "col": 0,
              "row": 1,
              "width": 12,
              "height": 6
            },
            "meta": {
              "description": "Hold Baggage Screening. Every checked bag is screened here by law, whether or not anything looks wrong with it."
            }
          },
          {
            "id": "z_bh_makeup",
            "label": "Make-up Area",
            "color": "#3c8fc4",
            "bounds": {
              "col": 13,
              "row": 1,
              "width": 13,
              "height": 6
            },
            "meta": {
              "description": "Where bags are grouped by flight and stacked into carts or containers ready for the stand."
            }
          }
        ],
        "components": [
          {
            "id": "bh_induction",
            "label": "Induction",
            "type": "queue",
            "icon": "arrowRightToBracket",
            "position": {
              "col": 1,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "The bag joins the main belt and its tag is read by an array of laser scanners."
            }
          },
          {
            "id": "bh_xray",
            "label": "HBS X-ray",
            "type": "service",
            "icon": "radiation",
            "position": {
              "col": 5,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Standard 3 explosive detection system. Bags it cannot clear automatically are diverted to an operator, then to a manual search room."
            }
          },
          {
            "id": "bh_sorter",
            "label": "Tilt-tray Sorter",
            "type": "function",
            "icon": "shuffle",
            "position": {
              "col": 9,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Reads the tag, looks up the flight, and tips the bag off the loop at the right moment."
            }
          },
          {
            "id": "bh_chute",
            "label": "Flight Chute",
            "type": "queue",
            "icon": "arrowDown",
            "position": {
              "col": 14,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "A spiral chute dedicated to one flight. Bags for other flights carry on round the loop."
            }
          },
          {
            "id": "bh_makeup",
            "label": "Make-up Carousel",
            "type": "database",
            "shape": "cylinder",
            "icon": "rotate",
            "position": {
              "col": 18,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "A holding carousel. Bags circulate here until the handlers are ready to load, which is why an early bag drop does not mean an early bag."
            }
          },
          {
            "id": "bh_loading",
            "label": "Cart Loading",
            "type": "service",
            "icon": "dolly",
            "position": {
              "col": 22,
              "row": 3
            },
            "size": {
              "w": 2,
              "h": 1
            },
            "meta": {
              "description": "Handlers stack bags into carts or unit load devices, reconciling each tag against the flight's bag list."
            }
          }
        ],
        "connections": [
          {
            "id": "c_bh_ind_xray",
            "from": "bh_induction",
            "to": "bh_xray",
            "label": "main belt",
            "route": "auto"
          },
          {
            "id": "c_bh_xray_sort",
            "from": "bh_xray",
            "to": "bh_sorter",
            "label": "cleared belt",
            "route": "auto"
          },
          {
            "id": "c_bh_sort_chute",
            "from": "bh_sorter",
            "to": "bh_chute",
            "label": "tip to chute",
            "route": "auto"
          },
          {
            "id": "c_bh_chute_makeup",
            "from": "bh_chute",
            "to": "bh_makeup",
            "label": "spiral",
            "route": "auto"
          },
          {
            "id": "c_bh_makeup_load",
            "from": "bh_makeup",
            "to": "bh_loading",
            "label": "off the carousel",
            "route": "auto"
          }
        ]
      }
    },
    {
      "id": "bag_tug",
      "label": "Baggage Tug",
      "type": "function",
      "icon": "truck",
      "position": {
        "col": 22,
        "row": 8
      },
      "size": {
        "w": 2,
        "h": 1
      },
      "meta": {
        "description": "Tows the cart train from the hall exit across the service road to the aircraft stand.",
        "notes": "Tug drivers follow marked roads with right of way rules of their own."
      }
    },
    {
      "id": "aircraft",
      "label": "Aircraft",
      "type": "external",
      "icon": "planeDeparture",
      "position": {
        "col": 22,
        "row": 3
      },
      "size": {
        "w": 3,
        "h": 2
      },
      "meta": {
        "description": "The airline's asset, not the airport's \u2014 hence external. Passengers board through the front door, bags through the hold.",
        "notes": "Load control has to know both the bag count and the passenger count before it can sign the loadsheet."
      }
    }
  ],
  "connections": [
    {
      "id": "c_kerb_checkin",
      "from": "kerbside",
      "to": "checkin_desk",
      "label": "walk to desk",
      "route": "auto"
    },
    {
      "id": "c_checkin_bagdrop",
      "from": "checkin_desk",
      "to": "bag_drop",
      "label": "tagged bag",
      "route": "auto"
    },
    {
      "id": "c_bagdrop_security",
      "from": "bag_drop",
      "to": "security",
      "label": "passenger only",
      "route": "auto"
    },
    {
      "id": "c_bagdrop_hall",
      "from": "bag_drop",
      "to": "baggage_hall",
      "label": "belt down",
      "route": "auto"
    },
    {
      "id": "c_sec_concourse",
      "from": "security",
      "to": "concourse",
      "label": "cleared airside",
      "route": "auto"
    },
    {
      "id": "c_concourse_gate",
      "from": "concourse",
      "to": "gate",
      "label": "walk to gate",
      "route": "auto"
    },
    {
      "id": "c_gate_aircraft",
      "from": "gate",
      "to": "aircraft",
      "label": "jet bridge",
      "route": "auto"
    },
    {
      "id": "c_hall_tug",
      "from": "baggage_hall",
      "to": "bag_tug",
      "label": "cart train",
      "route": "auto"
    },
    {
      "id": "c_tug_aircraft",
      "from": "bag_tug",
      "to": "aircraft",
      "label": "belt loader",
      "route": "auto"
    }
  ],
  "steps": [
    {
      "id": 0,
      "name": "Overview",
      "title": "Two journeys, one aircraft",
      "description": "A passenger and their suitcase arrive at the kerb together. From bag drop onwards they take completely separate routes through the airport and only meet again on the stand.",
      "highlight": [],
      "active_connections": [],
      "camera": {
        "fit": true
      }
    },
    {
      "id": 1,
      "name": "Kerbside",
      "title": "Set-down at departures",
      "description": "The passenger is dropped at the kerb and walks into the check-in hall. Nothing here is secure: landside is open to anyone.",
      "highlight": [
        "kerbside",
        "checkin_desk"
      ],
      "active_connections": [
        "c_kerb_checkin"
      ],
      "annotations": [
        {
          "type": "callout",
          "target": "kerbside",
          "text": "1 passenger + 1 hold bag, 23 kg"
        }
      ],
      "packet": {
        "connection": "c_kerb_checkin",
        "shape": "sphere",
        "data": {
          "pnr": "QK7T2R",
          "flight": "BA1487",
          "pax": 1,
          "hold_bags": 1
        }
      },
      "waterfall": {
        "start": 0,
        "weight": 6,
        "label": "6 min \u00b7 kerb to hall"
      }
    },
    {
      "id": 2,
      "name": "Check-in",
      "title": "Documents checked, bag tagged",
      "description": "The agent verifies the booking and travel documents, weighs the suitcase and prints a bag tag. From this moment the bag has an identity of its own.",
      "highlight": [
        "checkin_desk",
        "bag_drop"
      ],
      "active_connections": [
        "c_checkin_bagdrop"
      ],
      "camera": {
        "focus": "checkin_desk",
        "zoom": 1.4
      },
      "annotations": [
        {
          "type": "transform",
          "target": "checkin_desk",
          "text": "acceptBag(pnr) \u2192 printTag('0125 664213')",
          "style": "success"
        }
      ],
      "packet": {
        "connection": "c_checkin_bagdrop",
        "shape": "document",
        "arrivalStyle": "success",
        "data": {
          "tag": "0125664213",
          "weight_kg": 23.4,
          "flight": "BA1487",
          "destination": "SIN"
        }
      },
      "footer": [
        {
          "text": "The tag number is the **licence plate** every downstream system tracks",
          "style": "info"
        }
      ],
      "waterfall": {
        "start": 6,
        "weight": 9,
        "label": "9 min \u00b7 desk queue"
      }
    },
    {
      "id": 3,
      "name": "Paths diverge",
      "title": "The suitcase goes one way, the passenger the other",
      "description": "At bag drop the two journeys split. The suitcase drops onto a belt heading down into the baggage hall; the passenger walks to the security checkpoint carrying only cabin baggage.",
      "highlight": [
        "bag_drop",
        "baggage_hall",
        "security"
      ],
      "active_connections": [
        "c_bagdrop_hall",
        "c_bagdrop_security"
      ],
      "packets": [
        {
          "connection": "c_bagdrop_hall",
          "shape": "blob",
          "arrivalStyle": "success",
          "data": {
            "tag": "0125664213",
            "route": "hold"
          }
        },
        {
          "connection": "c_bagdrop_security",
          "shape": "sphere",
          "data": {
            "pax": "1 adult",
            "cabin_bags": 1,
            "route": "checkpoint"
          }
        }
      ],
      "footer": [
        {
          "text": "Everything after this point happens *in parallel* \u2014 the bars overlap deliberately",
          "style": "info"
        }
      ],
      "waterfall": {
        "start": 15,
        "weight": 4,
        "label": "4 min \u00b7 bag drop"
      }
    },
    {
      "id": 4,
      "scene": "baggage_hall",
      "name": "Induction",
      "title": "The bag joins the main belt",
      "description": "Below the terminal the suitcase is inducted onto the main conveyor. A ring of laser scanners reads the bag tag from every angle as it passes.",
      "highlight": [
        "bh_induction",
        "bh_xray"
      ],
      "active_connections": [
        "c_bh_ind_xray"
      ],
      "streams": [
        {
          "connection": "c_bh_ind_xray",
          "color": "#c4643c"
        }
      ],
      "annotations": [
        {
          "type": "callout",
          "target": "bh_induction",
          "text": "tagRead('0125664213') @ 0.5 m/s"
        }
      ],
      "footer": [
        {
          "text": "The belt is a **stream**, not a series of parcels \u2014 it runs whether or not there is a bag on it",
          "style": "info"
        }
      ],
      "waterfall": {
        "start": 19,
        "weight": 2,
        "label": "2 min \u00b7 induction"
      }
    },
    {
      "id": 5,
      "scene": "baggage_hall",
      "name": "Hold screening",
      "title": "Every hold bag is X-rayed",
      "description": "Hold Baggage Screening is mandatory for every checked bag, not a spot check. The machine clears most bags automatically; the rest go to a human operator and then to a search room.",
      "highlight": [
        "bh_xray",
        "bh_sorter"
      ],
      "active_connections": [
        "c_bh_xray_sort"
      ],
      "streams": [
        {
          "connection": "c_bh_xray_sort",
          "color": "#c4643c"
        }
      ],
      "annotations": [
        {
          "type": "transform",
          "target": "bh_xray",
          "text": "screen(bag) \u2192 level1.clear() \u2192 releaseToSorter()",
          "style": "success"
        }
      ],
      "waterfall": {
        "start": 21,
        "weight": 3,
        "label": "3 min \u00b7 HBS screening"
      }
    },
    {
      "id": 6,
      "scene": "baggage_hall",
      "name": "Sortation",
      "title": "The sorter tips the bag off the loop",
      "description": "A tilt-tray sorter matches the tag to a flight and tips the bag into that flight's chute at exactly the right moment. Bags for other flights stay on the loop.",
      "highlight": [
        "bh_sorter",
        "bh_chute"
      ],
      "active_connections": [
        "c_bh_sort_chute"
      ],
      "camera": {
        "focus": "bh_sorter",
        "zoom": 1.5
      },
      "packet": {
        "connection": "c_bh_sort_chute",
        "shape": "blob",
        "arrivalStyle": "success",
        "data": {
          "tag": "0125664213",
          "flight": "BA1487",
          "chute": "S14"
        }
      },
      "waterfall": {
        "start": 24,
        "weight": 1,
        "label": "1 min \u00b7 sortation"
      }
    },
    {
      "id": 7,
      "scene": "baggage_hall",
      "name": "Make-up",
      "title": "Waiting on the make-up carousel",
      "description": "The suitcase slides down the spiral chute onto a carousel shared by the flight. It circulates there until handlers start loading \u2014 which is why dropping a bag early does not make it arrive early.",
      "highlight": [
        "bh_chute",
        "bh_makeup"
      ],
      "active_connections": [
        "c_bh_chute_makeup"
      ],
      "packet": {
        "connection": "c_bh_chute_makeup",
        "shape": "blob",
        "data": {
          "tag": "0125664213",
          "carousel": "M09",
          "dwell": "waiting"
        }
      },
      "waterfall": {
        "start": 25,
        "weight": 6,
        "label": "6 min \u00b7 make-up dwell"
      }
    },
    {
      "id": 8,
      "scene": "baggage_hall",
      "name": "Cart loading",
      "title": "Bags stacked into the cart train",
